{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitLuna",
  "version": "0.1.0",
  "identifier": "com.daniel.git-app",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/git-app/browser"
  },
  "app": {
    "windows": [
      {
        "title": "GitLuna",
        "width": 1600,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
