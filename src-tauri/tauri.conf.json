{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitLuna",
  "version": "0.1.0",
  "identifier": "com.daniel.git-app",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/git-app/browser"
  },
  "app": {
    "windows": [
      {
        "title": "GitLuna",
        "width": 1600,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/gitluna.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0RTM5RjU2NzYyNjk2NkIKUldScmxpWjJWcC9qdE5JUHJWTU01czNUOUJWWGFxS25QNU1wUlhsa0I0NURtRlB2aFFxRm8rYjkK",
      "endpoints": [
        "https://files.danielsaluceste.com.br/public/gitluna/latest.json"
      ]
    }
  }
}
